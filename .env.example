# Copy this file to .env and fill in real values for local production testing.
# NEVER commit .env (it is gitignored).

# Port the Express server listens on. Render injects PORT automatically — do not
# hardcode it in the code.
PORT=3000

# Environment flag. Use "production" on the deployed server.
NODE_ENV=production

# Secret used to sign session cookies. MUST be a long random string in production
# (e.g. openssl rand -hex 48). If omitted locally, the app auto-generates one and
# stores it in ./data/.session-secret.
SESSION_SECRET=

# Absolute path of the SQLite database file on persistent storage.
# On Render point this INSIDE a mounted disk, e.g.:
DB_PATH=/var/data/sandronmart.db