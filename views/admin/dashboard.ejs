<%- include('../partials/header', { title: 'Admin Dashboard' }) %>

<div class="container">
  <section class="dash-hero">
    <h1>SANDRONMART Admin Dashboard</h1>
    <p>Welcome, <%= user.name %>. Here is the marketplace at a glance.</p>
    <span class="user-badge on-dark">ADMIN</span>
  </section>

  <section class="admin-stats">
    <div class="admin-stat">
      <div class="admin-stat-label">Total Products</div>
      <div class="admin-stat-value" id="admin-stat-products"><%= stats.totalProducts %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Total Buyers</div>
      <div class="admin-stat-value" id="admin-stat-buyers"><%= stats.totalBuyers %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Total Sellers</div>
      <div class="admin-stat-value" id="admin-stat-sellers"><%= stats.totalSellers %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Total Orders</div>
      <div class="admin-stat-value" id="admin-stat-orders"><%= stats.totalOrders %></div>
    </div>
  </section>

  <section class="dash-grid">
    <div class="dash-card action-card">
      <div class="card-icon">🌱</div>
      <h3>Products</h3>
      <p>Browse every product listed on the marketplace.</p>
      <a class="btn btn-primary btn-sm" href="/admin/products">View Products</a>
    </div>
    <div class="dash-card action-card">
      <div class="card-icon">👤</div>
      <h3>Buyers</h3>
      <p>View all registered buyer accounts.</p>
      <a class="btn btn-primary btn-sm" href="/admin/buyers">View Buyers</a>
    </div>
    <div class="dash-card action-card">
      <div class="card-icon">🏪</div>
      <h3>Sellers</h3>
      <p>View all registered seller accounts.</p>
      <a class="btn btn-primary btn-sm" href="/admin/sellers">View Sellers</a>
    </div>
    <div class="dash-card action-card">
      <div class="card-icon">📦</div>
      <h3>Orders</h3>
      <p>View every order placed in the marketplace.</p>
      <a class="btn btn-primary btn-sm" href="/admin/orders">View Orders</a>
    </div>
  </section>

  <% if (recentOrders.length > 0) { %>
    <section class="section-block">
      <div class="page-head">
        <div>
          <h2>Recent Orders</h2>
          <p class="muted">The latest <%= Math.min(recentOrders.length, 10) %> orders across all sellers.</p>
        </div>
        <a class="btn btn-outline btn-sm" href="/admin/orders">View All Orders</a>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Buyer</th>
            <th>Date</th>
            <th>Payment</th>
            <th>Total</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentOrders.forEach(function (order) { %>
            <tr>
              <td><strong><%= order.order_number %></strong></td>
              <td><%= order.buyer_name %></td>
              <td><%= order.orderDateLabel %></td>
              <td><%= order.payment_method === 'COD' ? 'Cash on Delivery' : (order.payment_method === 'UPI' ? 'UPI' : 'Card') %></td>
              <td><%= formatINR(order.total) %></td>
              <td><span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.statusLabel %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  <% } %>
</div>

<%- include('../partials/footer') %>