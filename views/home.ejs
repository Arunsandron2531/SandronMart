<%- include('partials/header', { title: 'Home' }) %>

<section class="container">
  <div class="hero">
    <span class="hero-badge">🌿 Grow your green thumb</span>
    <h1>Welcome to <span class="accent">SANDRONMART</span></h1>
    <p class="subtitle">Plants &amp; Gardening Marketplace</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/login">Login</a>
      <a class="btn btn-outline" href="/register">Create Account</a>
    </div>
  </div>

  <div class="hero-illustration">
    <div class="plant-card">
      <span class="emoji">🌱</span>
      <span class="label">Indoor Plants</span>
    </div>
    <div class="plant-card">
      <span class="emoji">🪴</span>
      <span class="label">Herbs &amp; Veggies</span>
    </div>
    <div class="plant-card">
      <span class="emoji">🧑‍🌾</span>
      <span class="label">Gardening Tools</span>
    </div>
  </div>

  <div class="role-grid">
    <div class="role-panel role-panel-buyer">
      <span class="role-panel-icon">🛍️</span>
      <h2 class="role-panel-title">Buyer</h2>
      <p class="role-panel-desc">Browse plants, seeds and gardening supplies from local farmers, then order for fast home delivery.</p>
      <a class="btn btn-primary role-panel-btn" href="/register">Shop as a Buyer</a>
    </div>
    <div class="role-panel role-panel-farmer">
      <span class="role-panel-icon">🧑‍🌾</span>
      <h2 class="role-panel-title">Farmer</h2>
      <p class="role-panel-desc">List your crops and plants, receive orders from buyers and manage fulfillment from your dashboard.</p>
      <a class="btn btn-outline role-panel-btn" href="/register">Sell as a Farmer</a>
    </div>
  </div>

  <div class="stats">
    <div class="stat">
      <div class="value">2</div>
      <div class="caption">Marketplace Roles</div>
    </div>
    <div class="stat">
      <div class="value">1</div>
      <div class="caption">Plant-Powered Community</div>
    </div>
    <div class="stat">
      <div class="value">∞</div>
      <div class="caption">Green Possibilities</div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>