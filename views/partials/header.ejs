<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - SANDRONMART</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="page">
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/">
        <span class="brand-icon">🌱</span>
        <span>SANDRONMART</span>
      </a>
      <nav class="nav-links">
        <% if (currentUser) { %>
          <span class="nav-user">Hi, <%= currentUser.name %></span>
          <span class="user-badge"><%= currentUser.role %></span>
          <% if (currentUser.role === 'SELLER') { %>
            <a class="nav-link" href="/seller/dashboard">Dashboard</a>
            <a class="nav-link" href="/seller/products">My Products</a>
            <a class="nav-link" href="/seller/orders">Orders</a>
          <% } else if (currentUser.role === 'ADMIN') { %>
            <a class="nav-link" href="/admin/dashboard">Dashboard</a>
            <a class="nav-link" href="/admin/products">Products</a>
            <a class="nav-link" href="/admin/buyers">Buyers</a>
            <a class="nav-link" href="/admin/sellers">Sellers</a>
            <a class="nav-link" href="/admin/orders">Orders</a>
          <% } else { %>
            <a class="nav-link" href="/buyer/dashboard">Home</a>
            <a class="nav-link" href="/buyer/products">Products</a>
            <a class="nav-link" href="/buyer/cart">Cart<% if (cartCount > 0) { %> (<%= cartCount %>)<% } %></a>
            <a class="nav-link" href="/buyer/account">My Account</a>
            <a class="nav-link" href="/buyer/orders">Orders</a>
          <% } %>
          <form method="post" action="/logout">
            <button class="btn btn-danger-outline btn-sm" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a class="btn btn-outline btn-sm" href="/login">Login</a>
          <a class="btn btn-primary btn-sm" href="/register">Create Account</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main">