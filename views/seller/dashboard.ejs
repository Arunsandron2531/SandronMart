<%- include('../partials/header', { title: 'Seller Dashboard' }) %>

<div class="container">
  <section class="dash-hero">
    <h1>SANDRONMART Seller Dashboard</h1>
    <p>Welcome, <%= user.name %>. Manage your store and grow your green business.</p>
    <span class="user-badge on-dark">SELLER</span>
  </section>

  <section class="admin-stats">
    <div class="admin-stat">
      <div class="admin-stat-label">Total Orders</div>
      <div class="admin-stat-value" id="seller-stat-total"><%= stats.totalOrders %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Pending</div>
      <div class="admin-stat-value" id="seller-stat-pending"><%= stats.statusCounts.PENDING %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Confirmed</div>
      <div class="admin-stat-value" id="seller-stat-confirmed"><%= stats.statusCounts.CONFIRMED %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Shipped</div>
      <div class="admin-stat-value" id="seller-stat-shipped"><%= stats.statusCounts.SHIPPED %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Delivered</div>
      <div class="admin-stat-value" id="seller-stat-delivered"><%= stats.statusCounts.DELIVERED %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Cancelled</div>
      <div class="admin-stat-value" id="seller-stat-cancelled"><%= stats.statusCounts.CANCELLED %></div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-label">Total Products Sold</div>
      <div class="admin-stat-value" id="seller-stat-sold"><%= stats.unitsSold %></div>
    </div>
  </section>

  <section class="dash-grid">
    <div class="dash-card action-card">
      <div class="card-icon">🌱</div>
      <h3>My Products</h3>
      <p>View, edit, and remove the items you sell.</p>
      <a class="btn btn-primary btn-sm" href="/seller/products">My Products</a>
    </div>
    <div class="dash-card action-card">
      <div class="card-icon">➕</div>
      <h3>Add Product</h3>
      <p>List a new plant, seed, or gardening tool.</p>
      <a class="btn btn-primary btn-sm" href="/seller/products/new">Add Product</a>
    </div>
    <div class="dash-card action-card">
      <div class="card-icon">📦</div>
      <h3>Incoming Orders</h3>
      <p>Update order status as items move through delivery.</p>
      <a class="btn btn-primary btn-sm" href="/seller/orders">Manage Orders</a>
    </div>
    <div class="dash-card">
      <div class="card-icon">🔒</div>
      <h3>Account</h3>
      <p><%= user.email %></p>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>