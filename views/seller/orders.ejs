<%- include('../partials/header', { title: 'Incoming Orders' }) %>

<div class="container">
  <div class="page-head">
    <div>
      <h1>Incoming Orders</h1>
      <p class="muted">Orders that include your products, with delivery and payment details.</p>
    </div>
  </div>

  <% if (messages.success) { %>
    <div class="alert alert-success"><%= messages.success %></div>
  <% } %>
  <% if (messages.error) { %>
    <div class="alert alert-error"><%= messages.error %></div>
  <% } %>

  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <h3>No incoming orders yet</h3>
      <p>Orders containing your products will appear here once buyers place them.</p>
      <a class="btn btn-primary" href="/seller/products">View My Products</a>
    </div>
  <% } else { %>
    <div class="order-list">
      <% orders.forEach(function (order) { %>
        <div class="order-card seller-order">
          <div class="order-head">
            <div class="order-id">
              <span class="muted">Order ID</span>
              <strong><%= order.order_number %></strong>
            </div>
            <div class="order-date">
              <span class="muted">Order Date</span>
              <strong><%= order.orderDateLabel %></strong>
            </div>
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.statusLabel %></span>
          </div>

          <div class="order-body">
            <div class="order-products">
              <% order.items.forEach(function (item) { %>
                <div class="order-product">
                  <% if (item.image_url) { %>
                    <img src="<%= item.image_url %>" alt="" loading="lazy"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
                    <div class="order-product-fallback" style="display:none;">🌱</div>
                  <% } else { %>
                    <div class="order-product-fallback">🌱</div>
                  <% } %>
                  <div>
                    <div class="order-product-name"><%= item.name %></div>
                    <div class="muted"><%= formatINR(item.price) %> &times; <%= item.quantity %></div>
                  </div>
                </div>
              <% }) %>
            </div>

            <div class="order-meta">
              <div class="order-meta-line">
                <span>Buyer</span>
                <span><strong><%= order.full_name %></strong> &middot; <%= order.phone %></span>
              </div>
              <div class="order-meta-line">
                <span>Delivery Address</span>
                <span><%= order.house_number %>, <%= order.street %>, <%= order.city %>, <%= order.state %> - <%= order.pincode %></span>
              </div>
              <div class="order-meta-line">
                <span>Expected Delivery</span>
                <span><%= order.deliveryLabel %></span>
              </div>
              <div class="order-meta-line">
                <span>Delivery Time</span>
                <span><%= order.delivery_time_slot %></span>
              </div>
              <div class="order-meta-line">
                <span>Payment</span>
                <span><%= order.payment_method === 'COD' ? 'Cash on Delivery' : (order.payment_method === 'UPI' ? 'UPI' : 'Credit / Debit Card') %></span>
              </div>
              <div class="order-meta-line">
                <span>Order Total</span>
                <strong><%= formatINR(order.total) %></strong>
              </div>
            </div>
          </div>

          <% if (['DELIVERED', 'CANCELLED'].includes(order.status)) { %>
            <div class="order-status-update">
              <span class="muted">This order is <strong><%= order.statusLabel %></strong> and cannot be changed.</span>
            </div>
          <% } else { %>
            <div class="order-status-update">
              <form class="status-form" method="post" action="/seller/orders/<%= order.id %>/status">
                <% const next = nextStatusOf(order.status); %>
                <% if (next) { %>
                  <button class="btn btn-primary btn-sm" type="submit" name="status" value="<%= next %>">
                    Mark as <%= orderStatusLabel(next) %>
                  </button>
                <% } %>
                <button class="btn btn-danger-outline btn-sm" type="submit" name="status" value="CANCELLED">Cancel Order</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>