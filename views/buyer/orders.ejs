<%- include('../partials/header', { title: 'My Orders' }) %>

<div class="container">
  <div class="page-head">
    <div>
      <h1>My Orders</h1>
      <p class="muted">Track your purchases.</p>
    </div>
  </div>

  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">📦</div>
      <h3>No orders yet</h3>
      <p>Your orders will appear here after you place an order.</p>
      <a class="btn btn-primary" href="/buyer/products">Browse Products</a>
    </div>
  <% } else { %>
    <div class="order-list">
      <% orders.forEach(function (order) { %>
        <div class="order-card">
          <div class="order-head">
            <div class="order-id">
              <span class="muted">Order ID</span>
              <strong><%= order.order_number %></strong>
            </div>
            <div class="order-date">
              <span class="muted">Order Date</span>
              <strong><%= order.orderDateLabel %></strong>
            </div>
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.statusLabel %></span>
          </div>

          <div class="order-body">
            <div class="order-products">
              <% order.items.forEach(function (item) { %>
                <div class="order-product">
                  <img src="<%= productImage(item) %>" alt="" loading="lazy"
                       data-default-image="<%= defaultProductImage(item.category) %>">
                  <div class="order-product-fallback image-fallback" style="display:none;">🌱</div>
                  <div>
                    <div class="order-product-name"><%= item.name %></div>
                    <div class="muted"><%= formatINR(item.price) %> &times; <%= item.quantity %></div>
                  </div>
                </div>
              <% }) %>
            </div>

            <div class="order-meta">
              <div class="order-meta-line">
                <span>Total</span>
                <strong><%= formatINR(order.total) %></strong>
              </div>
              <div class="order-meta-line">
                <span>Expected Delivery</span>
                <span><%= order.deliveryLabel %></span>
              </div>
              <div class="order-meta-line">
                <span>Delivery Time</span>
                <span><%= order.delivery_time_slot %></span>
              </div>
              <div class="order-meta-line">
                <span>Payment</span>
                <span><%= order.payment_method === 'COD' ? 'Cash on Delivery' : (order.payment_method === 'UPI' ? 'UPI' : 'Credit / Debit Card') %></span>
              </div>
            </div>
          </div>

          <div class="order-actions">
            <a class="btn btn-outline btn-sm" href="/buyer/orders/<%= order.id %>">View Details</a>
            <a class="btn btn-primary btn-sm" href="/buyer/orders/<%= order.id %>/track">Track Order</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>