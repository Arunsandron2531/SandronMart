<%- include('../partials/header', { title: 'Your Cart' }) %>

<div class="container">
  <div class="page-head">
    <div>
      <h1>Your Cart</h1>
      <p class="muted">Review the items in your shopping basket.</p>
    </div>
  </div>

  <% if (messages.success) { %>
    <div class="alert alert-success"><%= messages.success %></div>
  <% } %>
  <% if (messages.error) { %>
    <div class="alert alert-error"><%= messages.error %></div>
  <% } %>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🛒</div>
      <h3>Your cart is empty</h3>
      <p>Your cart is empty. Add some plants and gardening supplies to get started.</p>
      <a class="btn btn-primary" href="/buyer/products">Continue Shopping</a>
    </div>
  <% } else { %>
    <div class="cart-list">
      <% items.forEach(function (item) { %>
        <div class="cart-item">
          <div class="cart-thumb">
            <img class="cart-image" src="<%= productImage(item) %>" alt="<%= item.name %>"
                 loading="lazy" data-default-image="<%= defaultProductImage(item) %>">
            <div class="cart-image cart-image-fallback image-fallback" style="display:none;"></div>
          </div>
          <div class="cart-info">
            <span class="product-category"><%= item.category %></span>
            <h3 class="product-name"><%= item.name %></h3>
            <div class="cart-unit"><%= formatINR(item.price) %> each</div>
            <% if (item.quantity >= (item.stock || 0)) { %>
              <div class="cart-stock-warn">Only <%= item.stock %> items available.</div>
            <% } %>
          </div>
          <div class="cart-qty">
            <form class="qty-form" method="post" action="/buyer/cart/<%= item.cart_id %>/update">
              <input type="hidden" name="action" value="decrease">
              <button class="qty-btn" type="submit" aria-label="Decrease quantity">&minus;</button>
            </form>
            <span class="qty-value"><%= item.quantity %></span>
            <form class="qty-form" method="post" action="/buyer/cart/<%= item.cart_id %>/update">
              <input type="hidden" name="action" value="increase">
              <button class="qty-btn" type="submit" aria-label="Increase quantity">+</button>
            </form>
          </div>
          <div class="cart-subtotal"><%= formatINR(item.price * item.quantity) %></div>
          <form class="cart-remove" method="post" action="/buyer/cart/<%= item.cart_id %>/remove">
            <button class="btn btn-danger-outline btn-sm" type="submit">Remove</button>
          </form>
        </div>
      <% }) %>
    </div>

    <div class="cart-summary">
      <div class="cart-breakdown">
        <div class="cart-line">
          <span>Subtotal</span>
          <span><%= formatINR(subtotal) %></span>
        </div>
        <div class="cart-line">
          <span>Delivery</span>
          <span>
            <% if (deliveryCharge === 0) { %>
              <span class="free-badge">FREE</span>
              <span class="cart-stock-warn">(Free delivery on orders above <%= formatINR(freeDeliveryThreshold) %>)</span>
            <% } else { %>
              <%= formatINR(deliveryCharge) %>
            <% } %>
          </span>
        </div>
        <div class="cart-line cart-line-total">
          <span>Total</span>
          <span class="cart-total"><strong><%= formatINR(total) %></strong></span>
        </div>
      </div>
      <div class="cart-summary-actions">
        <a class="btn btn-outline" href="/buyer/products">Continue Shopping</a>
        <a class="btn btn-primary" href="/buyer/checkout">Proceed to Checkout</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>