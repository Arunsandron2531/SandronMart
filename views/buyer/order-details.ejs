<%- include('../partials/header', { title: 'Order Details' }) %>

<div class="container">
  <div class="page-head">
    <div>
      <h1>Order Details</h1>
      <p class="muted">Order <%= order.order_number %></p>
    </div>
    <a class="btn btn-outline" href="/buyer/orders">&larr; Back to My Orders</a>
  </div>

  <div class="order-detail-grid">
    <div class="detail-main">

      <section class="checkout-section">
        <h2 class="section-title">Order Summary</h2>
        <div class="summary-items">
          <% order.items.forEach(function (item) { %>
            <div class="summary-item">
              <div class="summary-thumb">
                <img src="<%= productImage(item) %>" alt="" loading="lazy"
                     data-default-image="<%= defaultProductImage(item) %>">
                <div class="summary-fallback image-fallback" style="display:none;"></div>
              </div>
              <div class="summary-info">
                <div class="summary-name"><%= item.name %></div>
                <div class="muted"><%= formatINR(item.price) %> &times; <%= item.quantity %></div>
              </div>
              <div class="summary-price"><%= formatINR(item.price * item.quantity) %></div>
            </div>
          <% }) %>
        </div>
        <div class="summary-lines">
          <div class="summary-line">
            <span>Item Subtotal</span>
            <span><%= formatINR(order.subtotal) %></span>
          </div>
          <div class="summary-line">
            <span>Delivery Charge</span>
            <span><% if (order.delivery_charge === 0) { %><span class="free-badge">FREE</span><% } else { %><%= formatINR(order.delivery_charge) %><% } %></span>
          </div>
          <div class="summary-line grand-total">
            <span>Grand Total</span>
            <span><strong><%= formatINR(order.total) %></strong></span>
          </div>
        </div>
      </section>

      <section class="checkout-section">
        <h2 class="section-title">Delivery Address</h2>
        <div class="address-summary">
          <strong><%= order.full_name %></strong>
          <div><%= order.house_number %>, <%= order.street %></div>
          <% if (order.landmark) { %><div>Near <%= order.landmark %></div><% } %>
          <div><%= order.city %><% if (order.district) { %>, <%= order.district %><% } %></div>
          <div><%= order.state %> - <%= order.pincode %></div>
          <div class="muted">Mobile: <%= order.phone %></div>
        </div>
      </section>
    </div>

    <aside class="checkout-side">
      <div class="order-summary-card">
        <h2 class="section-title">Order Information</h2>
        <div class="order-meta stack">
          <div class="order-meta-line">
            <span>Order ID</span>
            <strong><%= order.order_number %></strong>
          </div>
          <div class="order-meta-line">
            <span>Order Date</span>
            <span><%= order.orderDateLabel %></span>
          </div>
          <div class="order-meta-line">
            <span>Order Status</span>
            <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.statusLabel %></span>
          </div>
          <div class="order-meta-line">
            <span>Expected Delivery</span>
            <span><%= order.deliveryLabel %></span>
          </div>
          <div class="order-meta-line">
            <span>Delivery Time</span>
            <span><%= order.delivery_time_slot %></span>
          </div>
          <div class="order-meta-line">
            <span>Payment Method</span>
            <span><%= order.paymentLabel %></span>
          </div>
          <div class="order-meta-line">
            <span>Total</span>
            <strong><%= formatINR(order.total) %></strong>
          </div>
        </div>
        <a class="btn btn-primary btn-block" href="/buyer/orders/<%= order.id %>/track">Track Order</a>
      </div>
    </aside>
  </div>
</div>

<%- include('../partials/footer') %>