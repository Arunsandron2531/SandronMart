<%- include('../../partials/header', { title: 'Browse Products' }) %>

<div class="container">
  <div class="page-head">
    <div>
      <h1>Browse Products</h1>
      <p class="muted">Discover plants and gardening supplies from our sellers.</p>
    </div>
  </div>

  <% if (messages.success) { %>
    <div class="alert alert-success"><%= messages.success %></div>
  <% } %>
  <% if (messages.error) { %>
    <div class="alert alert-error"><%= messages.error %></div>
  <% } %>

  <form class="filter-bar" method="get" action="/buyer/products">
    <input class="input" type="search" name="search" placeholder="Search by name, description, or category..."
           value="<%= search %>" aria-label="Search products">
    <select class="input" name="category" aria-label="Filter by category">
      <option value="">All Categories</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category %>" <%= category === selectedCategory ? 'selected' : '' %>><%= category %></option>
      <% }) %>
    </select>
    <button class="btn btn-primary" type="submit">Search</button>
    <% if (search || selectedCategory) { %>
      <a class="btn btn-outline" href="/buyer/products">Clear</a>
    <% } %>
  </form>

  <% if (products.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🌿</div>
      <h3>No products found</h3>
      <p>Try adjusting your search or category filter.</p>
    </div>
  <% } else { %>
    <div class="product-grid">
      <% products.forEach(function (product) { %>
        <div class="product-card">
          <form class="wishlist-form" method="post" action="/buyer/wishlist/toggle">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <input type="hidden" name="redirect" value="/buyer/products">
            <button type="submit"
                    class="heart-btn <%= wishlistIds.has(product.id) ? 'active' : '' %>"
                    aria-label="<%= wishlistIds.has(product.id) ? 'Remove from wishlist' : 'Add to wishlist' %>"
                    title="<%= wishlistIds.has(product.id) ? 'Remove from wishlist' : 'Add to wishlist' %>">&#9829;</button>
          </form>
          <img class="product-thumb" src="<%= productImage(product) %>" alt="<%= product.name %>"
               loading="lazy" data-default-image="<%= defaultProductImage(product) %>">
          <div class="product-thumb product-thumb-fallback image-fallback" style="display:none;"></div>
          <div class="product-body">
            <div class="product-meta">
              <span class="product-category"><%= product.category %></span>
              <span class="stock-chip <%= product.stock === 0 ? 'stock-out' : 'stock-in' %>">
                <%= product.stock === 0 ? 'Out of stock' : product.stock + ' in stock' %>
              </span>
            </div>
            <h3 class="product-name"><%= product.name %></h3>
            <div class="product-price"><%= formatINR(product.price) %></div>
            <p class="product-desc"><%= product.description %></p>
            <div class="product-actions">
              <a class="btn btn-primary btn-sm" href="/buyer/products/<%= product.id %>">View Details</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>