<%- include('partials/header', { title: 'Login' }) %>

<div class="auth-wrap">
  <aside class="auth-side">
    <div class="brand-mark">🌱</div>
    <h2>Welcome back to your garden.</h2>
    <p>Sign in to SANDRONMART to continue shopping for plants, seeds, and tools &mdash; or to manage your store as a seller.</p>
    <div class="points">
      <div class="point"><span>✓</span> Discover fresh plants &amp; seeds</div>
      <div class="point"><span>✓</span> Sell your own greenery</div>
      <div class="point"><span>✓</span> Secure, role-based accounts</div>
    </div>
  </aside>

  <section class="auth-main">
    <div class="auth-card">
      <h1 class="auth-title">Login</h1>
      <p class="auth-sub">Sign in to your account to continue.</p>

      <% if (successMessage) { %>
        <div class="alert alert-success"><%= successMessage %></div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="alert alert-error"><%= errorMessage %></div>
      <% } %>

      <div class="login-choices" role="tablist">
        <button type="button" class="login-choice <%= openForm === 'admin' ? '' : 'active' %>"
                data-target="panel-buyer" role="tab" aria-selected="<%= openForm === 'admin' ? 'false' : 'true' %>">Buyer</button>
        <button type="button" class="login-choice" data-target="panel-seller" role="tab" aria-selected="false">Seller</button>
        <button type="button" class="login-choice login-choice-admin <%= openForm === 'admin' ? 'active' : '' %>"
                data-target="panel-admin" role="tab" aria-selected="<%= openForm === 'admin' ? 'true' : 'false' %>">Admin Login</button>
      </div>

      <div class="auth-panel" id="panel-buyer" style="<%= openForm === 'admin' ? 'display:none' : '' %>">
        <h2 class="auth-panel-heading">Buyer Login</h2>
        <form method="post" action="/login" novalidate>
          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input class="input <%= errors && errors.email ? 'invalid' : '' %>" type="email"
                   id="email" name="email" value="<%= form.email || '' %>"
                   placeholder="you@example.com" autofocus>
            <% if (errors && errors.email) { %>
              <span class="field-error"><%= errors.email[0] %></span>
            <% } %>
          </div>

          <div class="field">
            <label for="password">Password <span class="req">*</span></label>
            <input class="input <%= errors && errors.password ? 'invalid' : '' %>" type="password"
                   id="password" name="password" placeholder="Enter your password">
            <% if (errors && errors.password) { %>
              <span class="field-error"><%= errors.password[0] %></span>
            <% } %>
          </div>

          <div class="field form-hint">
            <a href="#">Forgot Password?</a>
          </div>

          <button class="btn btn-primary btn-block" type="submit">Login as Buyer</button>
        </form>

        <p class="form-hint pt-12 center">
          Don't have an account?
          <a href="/register">Create Account</a>
        </p>

        <p class="form-hint center">
          <a href="/">&larr; Back to Home</a>
        </p>
      </div>

      <div class="auth-panel" id="panel-seller" style="display:none">
        <h2 class="auth-panel-heading">Seller Login</h2>
        <form method="post" action="/login" novalidate>
          <div class="field">
            <label for="sellerEmail">Email <span class="req">*</span></label>
            <input class="input <%= errors && errors.email ? 'invalid' : '' %>" type="email"
                   id="sellerEmail" name="email" value="<%= form.email || '' %>"
                   placeholder="you@example.com">
            <% if (errors && errors.email) { %>
              <span class="field-error"><%= errors.email[0] %></span>
            <% } %>
          </div>

          <div class="field">
            <label for="sellerPassword">Password <span class="req">*</span></label>
            <input class="input <%= errors && errors.password ? 'invalid' : '' %>" type="password"
                   id="sellerPassword" name="password" placeholder="Enter your password">
            <% if (errors && errors.password) { %>
              <span class="field-error"><%= errors.password[0] %></span>
            <% } %>
          </div>

          <div class="field form-hint">
            <a href="#">Forgot Password?</a>
          </div>

          <button class="btn btn-primary btn-block" type="submit">Login as Seller</button>
        </form>

        <p class="form-hint pt-12 center">
          Don't have an account?
          <a href="/register">Create Account</a>
        </p>

        <p class="form-hint center">
          <a href="/">&larr; Back to Home</a>
        </p>
      </div>

      <div class="auth-panel" id="panel-admin" style="<%= openForm === 'admin' ? '' : 'display:none' %>">
        <h2 class="auth-panel-heading">Admin Login</h2>
        <% if (adminConfigured) { %>
          <form method="post" action="/login" novalidate>
            <div class="field">
              <label for="adminEmail">Admin Email <span class="req">*</span></label>
              <input class="input" type="email"
                     id="adminEmail" name="email" value="<%= form.email || '' %>"
                     placeholder="admin@example.com">
            </div>

            <div class="field">
              <label for="adminPassword">Password <span class="req">*</span></label>
              <input class="input" type="password"
                     id="adminPassword" name="password" placeholder="Enter your password">
            </div>

            <button class="btn btn-primary btn-block" type="submit">Admin Login</button>
          </form>
        <% } else { %>
          <div class="setup-note">
            <p><strong>No admin account has been set up yet.</strong></p>
            <p>Set the email and password for the store administrator to enable Admin Login.</p>
            <a class="btn btn-primary btn-block" href="/admin/setup">Set Up Admin Account</a>
          </div>
        <% } %>

        <p class="form-hint center">
          <a href="/">&larr; Back to Home</a>
        </p>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
<script src="/js/validation.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form[action="/login"]').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (!LoginValidation.validate(form)) {
          e.preventDefault();
        }
      });
    });

    document.querySelectorAll('.login-choices .login-choice').forEach(function (choice) {
      choice.addEventListener('click', function () {
        document.querySelectorAll('.login-choices .login-choice').forEach(function (c) {
          c.classList.remove('active');
          c.setAttribute('aria-selected', 'false');
        });
        choice.classList.add('active');
        choice.setAttribute('aria-selected', 'true');
        document.querySelectorAll('.auth-panel').forEach(function (panel) {
          panel.style.display = 'none';
        });
        var target = document.getElementById(choice.getAttribute('data-target'));
        if (target) {
          target.style.display = 'block';
        }
      });
    });
  });
</script>